# Live generation provider
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_S=60

# Opportunity preflight
# Leave OPPORTUNITY_MODEL blank to reuse LLM_MODEL; set a cheaper model explicitly if desired.
OPPORTUNITY_MODEL=
OPPORTUNITY_MIN_SCORE=60

# Generation behavior
TEMPERATURE=0.5
# One full draft is the efficient default. Raise only for deliberate experiments.
N_VARIANTS=1
APP_ENV=dev
